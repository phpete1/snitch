#!/usr/bin/env php
<?php

require $_composer_autoload_path ?? __DIR__.'/../vendor/autoload.php';

use Phpete1\Snitch\BinaryResolver;
use Phpete1\Snitch\Installer;

try {
    $contents = @file_get_contents('composer.json');
    $data = is_string($contents) ? json_decode($contents, true) : null;

    $extra = is_array($data) ? ($data['extra'] ?? null) : null;
    $snitch = is_array($extra) ? ($extra['snitch'] ?? null) : null;
    $version = is_array($snitch) && is_string($snitch['version'] ?? null)
        ? $snitch['version']
        : null;

    $resolver = new BinaryResolver(version: $version);

    if (! $resolver->canExecute()) {
        fwrite(STDERR, "Downloading Betterleaks...\n");
        (new Installer($resolver))->run();
    }
} catch (Throwable $exception) {
    fwrite(STDERR, "snitch: {$exception->getMessage()}\n");
    exit(2);
}

$command = escapeshellarg($resolver->executablePath).' dir -v';

passthru(command: $command, result_code: $code);

exit($code);
