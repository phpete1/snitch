{
    "name": "phpete1/snitch",
    "description": "Scan your PHP project for leaked secrets with one command, powered by Betterleaks.",
    "type": "library",
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "ext-phar": "*",
        "ext-zlib": "*"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Phpete1\\Snitch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phpete1\\Snitch\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse"
    },
    "authors": [
        {
            "name": "Peter Stuart",
            "email": "peter@phpete.com"
        }
    ],
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan-phpunit": "^2.1"
    },
    "bin": ["bin/snitch"]
}
